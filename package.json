    "test": "node scripts/run-tests.mjs",
    "bundle-crosspet": "node scripts/bundle-crosspet.mjs",
    "package": "node scripts/package-win.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "esbuild": "^0.28.2",
    "pixi.js": "^8.23.0"
  }
}
